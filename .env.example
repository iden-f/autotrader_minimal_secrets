# Copy to .env for local runs. On GitHub, add these as repository secrets
# instead (Settings -> Secrets and variables -> Actions).
# Everything is optional: the bot turns on whichever channels it finds.

# --- Telegram (free, instant, best default) -------------------------------
# Message @BotFather -> /newbot -> copy the token. Then message your new bot
# once and open https://api.telegram.org/bot<TOKEN>/getUpdates to read the id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (free) --------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- ntfy (free, no account at all) ---------------------------------------
# Set the topic in config.json, not here. Only needed for a private server.
NTFY_TOKEN=

# --- Slack (free) ----------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Email (free) ----------------------------------------------------------
# Needs 2-Step Verification, then an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- SMS (costs money; Telegram or ntfy do the same job for free) ----------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# --- Upgrading from v1 -----------------------------------------------------
# If this is still set it is imported automatically as your first search.
SEARCH_URL=
